{
  "uid": "catalog-rollout",
  "title": "Rollout del catálogo",
  "description": "Activación progresiva del servicio de catálogo (M2 C4): flag, guard, comparación de los dos caminos en la misma ventana y la búsqueda contra la línea base B.",
  "tags": [
    "twa",
    "flights",
    "catalog",
    "rollout"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Cambios del flag",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(catalog:rollout_remote_percentage:max[1m]) > 0",
        "step": "15s",
        "titleFormat": "Cambio del flag",
        "textFormat": "El porcentaje remoto cambió"
      },
      {
        "name": "Rollbacks del guard",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "increase(catalog_rollout_rollbacks_total{service=\"twa-flights-monolith\"}[1m]) > 0",
        "step": "15s",
        "titleFormat": "Rollback {{rule}}",
        "textFormat": "CatalogRolloutGuard volvió a 0 %"
      }
    ]
  },
  "links": [
    {
      "title": "Runbook",
      "type": "link",
      "url": "https://github.com/andres-sacco/twa-flights-monolith/blob/main/observability/runbooks/catalog-rollout.md",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Estado ahora",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Flag (% remoto)",
      "description": "catalog_rollout_remote_percentage: el porcentaje que aplica cada instancia (el máximo).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "catalog:rollout_remote_percentage:max",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "background"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Rollbacks del guard (24 h)",
      "description": "catalog_rollout_rollbacks_total. Con más de 0 no se vuelve a subir el porcentaje sin revisar la causa (CatalogRolloutRolledBack).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(catalog_rollout_rollbacks_total{service=\"twa-flights-monolith\"}[24h])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "background"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Llamadas remotas / min-calls",
      "description": "Llamadas remotas por ventana del guard sobre min-calls, en la instancia con menos tráfico. Debajo de 100 % el guard no evalúa: CatalogRolloutGuardBlind.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(sum by (instance) (increase(catalog_lookup_seconds_count{service=\"twa-flights-monolith\", path=\"remote\"}[2m])) * on (instance) catalog_rollout_guard_window_seconds{service=\"twa-flights-monolith\"} / 120 / on (instance) catalog_rollout_guard_min_calls{service=\"twa-flights-monolith\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "background"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Línea base B (p95 búsqueda)",
      "description": "Mediana de los p95 de 5 min de los últimos 7 días con el flag en 0 %. Sin valor: CatalogSearchLatency no puede disparar.",
