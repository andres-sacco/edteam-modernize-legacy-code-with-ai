          "expr": "search:latency_seconds:p95_baseline7d",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "background"
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Historia de B",
      "description": "Horas con el flag en 0 % que usa B. El plan pide 168 (7 días).",
