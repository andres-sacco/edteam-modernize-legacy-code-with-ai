    {
      "type": "alertlist",
      "title": "Alertas activas",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 6
      },
      "description": "Alertas activas de Alertmanager. Cada una tiene su runbook en observability/runbooks/.",
      "options": {
        "alertInstanceLabelFilter": "",
